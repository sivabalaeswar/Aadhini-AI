<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:padding="0dp">
    <WebView android:id="@+id/webViewAvatar" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/tvStatus" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⬡ AADHINI" android:textColor="@color/accent_blue" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.2" android:layout_marginTop="18dp" android:layout_marginStart="20dp" android:elevation="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AaNira • Realistic Avatar Preview" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginStart="20dp" android:elevation="8dp" app:layout_constraintTop_toBottomOf="@id/tvAppName" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:text="AaNira ready" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp" android:background="@drawable/status_bg" android:padding="12dp" android:fontFamily="sans-serif" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="8dp" app:layout_constraintBottom_toTopOf="@id/layoutChat" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/layoutChat" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="8dp" app:layout_constraintBottom_toTopOf="@id/layoutButtons" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <EditText android:id="@+id/etChatInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="Talk to AaNira..." android:singleLine="true" android:inputType="textCapSentences" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:background="@drawable/status_bg" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginEnd="6dp" />
        <Button android:id="@+id/btnSend" android:layout_width="52dp" android:layout_height="48dp" android:text="➤" android:textSize="18sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:stateListAnimator="@null" />
        <Button android:id="@+id/btnVoice" android:layout_width="52dp" android:layout_height="48dp" android:text="🎙" android:textSize="16sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:layout_marginStart="6dp" android:stateListAnimator="@null" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layoutButtons" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="12dp" android:gravity="center" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnSpeak" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Status" android:textSize="11sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:layout_marginEnd="4dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnDecision" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Decision" android:textSize="11sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:layout_marginStart="4dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnMemory" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Memory" android:textSize="11sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:layout_marginStart="4dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnAgents" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Agents" android:textSize="11sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:layout_marginStart="4dp" android:stateListAnimator="@null" />
        </LinearLayout>
        <Button android:id="@+id/btnProvider" android:layout_width="match_parent" android:layout_height="36dp" android:text="AaNira v02 • AVATAR PREVIEW" android:textSize="10sp" android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" android:stateListAnimator="@null" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
